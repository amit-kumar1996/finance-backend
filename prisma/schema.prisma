generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AuthChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum FinancialAccountType {
  BANK
  CASH
  UPI
  CREDIT_CARD
}

enum LedgerAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

enum LedgerTransactionSource {
  OPENING_BALANCE
  TRANSFER
  EXPENSE
  CREDIT_CARD_PURCHASE
  CREDIT_CARD_PAYMENT
  REVERSAL
  PERSON_GIVE
  PERSON_RECEIVE
  PERSON_BORROW
  PERSON_REPAY
  LOAN_DISBURSEMENT
  LOAN_OPENING_BALANCE
  LOAN_EMI_PAYMENT
  LOAN_PREPAYMENT
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

model User {
  id                      String               @id @db.VarChar(30)
  singleton               Boolean              @unique @default(true)
  defaultExpenseAccountId String?              @unique @map("default_expense_account_id") @db.VarChar(30)
  createdAt               DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  credentials             WebAuthnCredential[]
  sessions                AuthSession[]
  challenges              AuthChallenge[]
  recoveryCodes           RecoveryCode[]
  financialAccounts       FinancialAccount[]
  ledgerAccounts          LedgerAccount[]
  ledgerTransactions      LedgerTransaction[]
  auditLogs               AuditLog[]
  persons                 Person[]
  idempotencyRecords      IdempotencyRecord[]
  loans                   Loan[]
  defaultExpenseAccount   FinancialAccount?    @relation("DefaultExpenseAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)

  @@map("users")
}

model WebAuthnCredential {
  id               String    @id @default(cuid()) @db.VarChar(30)
  userId           String    @map("user_id") @db.VarChar(30)
  credentialId     String    @map("credential_id") @db.Text
  credentialIdHash String    @unique @map("credential_id_hash") @db.Char(64)
  publicKey        Bytes     @map("public_key") @db.Blob
  counter          Int       @default(0) @db.UnsignedInt
  transports       Json?
  deviceName       String?   @map("device_name") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model AuthChallenge {
  id         String               @id @default(cuid()) @db.VarChar(30)
  challenge  String               @unique @db.VarChar(200)
  purpose    AuthChallengePurpose
  userId     String?              @map("user_id") @db.VarChar(30)
  userHandle String?              @map("user_handle") @db.VarChar(30)
  expiresAt  DateTime             @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?            @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  user       User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt])
  @@index([userId])
  @@map("auth_challenges")
}

model AuthSession {
  id           String    @id @default(cuid()) @db.VarChar(30)
  userId       String    @map("user_id") @db.VarChar(30)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  recoveryOnly Boolean   @default(false) @map("recovery_only")
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RecoveryCode {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @map("user_id") @db.VarChar(30)
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("recovery_codes")
}

model FinancialAccount {
  id              String               @id @default(cuid()) @db.VarChar(30)
  userId          String               @map("user_id") @db.VarChar(30)
  name            String               @db.VarChar(100)
  accountType     FinancialAccountType @map("account_type")
  institutionName String?              @map("institution_name") @db.VarChar(100)
  ledgerAccountId String               @unique @map("ledger_account_id") @db.VarChar(30)
  idempotencyKey  String               @map("idempotency_key") @db.VarChar(128)
  requestHash     String               @map("request_hash") @db.Char(64)
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount        @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  defaultForUser  User?                @relation("DefaultExpenseAccount")

  @@unique([userId, idempotencyKey])
  @@index([userId, accountType])
  @@map("financial_accounts")
}

model LedgerAccount {
  id               String                @id @default(cuid()) @db.VarChar(30)
  userId           String                @map("user_id") @db.VarChar(30)
  code             String                @db.VarChar(40)
  name             String                @db.VarChar(100)
  category         LedgerAccountCategory
  normalBalance    LedgerNormalBalance   @map("normal_balance")
  isSystem         Boolean               @default(false) @map("is_system")
  createdAt        DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount?
  entries          TransactionEntry[]
  personReceivable Person?               @relation("PersonReceivable")
  personPayable    Person?               @relation("PersonPayable")
  loan             Loan?                 @relation("LoanLiability")

  @@unique([userId, code])
  @@index([userId, category])
  @@map("ledger_accounts")
}

model Person {
  id                  String        @id @default(cuid()) @db.VarChar(30)
  userId              String        @map("user_id") @db.VarChar(30)
  name                String        @db.VarChar(120)
  notes               String?       @db.VarChar(500)
  receivableAccountId String        @unique @map("receivable_account_id") @db.VarChar(30)
  payableAccountId    String        @unique @map("payable_account_id") @db.VarChar(30)
  archivedAt          DateTime?     @map("archived_at") @db.DateTime(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivableAccount   LedgerAccount @relation("PersonReceivable", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  payableAccount      LedgerAccount @relation("PersonPayable", fields: [payableAccountId], references: [id], onDelete: Restrict)

  @@index([userId, archivedAt, name])
  @@map("persons")
}

model IdempotencyRecord {
  id           String   @id @default(cuid()) @db.VarChar(30)
  userId       String   @map("user_id") @db.VarChar(30)
  key          String   @db.VarChar(128)
  requestHash  String   @map("request_hash") @db.Char(64)
  resourceType String   @map("resource_type") @db.VarChar(40)
  resourceId   String   @map("resource_id") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([resourceType, resourceId])
  @@map("idempotency_records")
}

model LedgerTransaction {
  id             String                  @id @default(cuid()) @db.VarChar(30)
  userId         String                  @map("user_id") @db.VarChar(30)
  effectiveDate  DateTime                @map("effective_date") @db.Date
  description    String                  @db.VarChar(250)
  source         LedgerTransactionSource
  idempotencyKey String                  @map("idempotency_key") @db.VarChar(128)
  requestHash    String                  @map("request_hash") @db.Char(64)
  reversalOfId   String?                 @unique @map("reversal_of_id") @db.VarChar(30)
  loanId         String?                 @map("loan_id") @db.VarChar(30)
  countsAsEmi    Boolean                 @default(true) @map("counts_as_emi")
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reversalOf     LedgerTransaction?      @relation("LedgerTransactionReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     LedgerTransaction?      @relation("LedgerTransactionReversals")
  loan           Loan?                   @relation(fields: [loanId], references: [id], onDelete: Restrict)
  entries        TransactionEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, effectiveDate])
  @@index([loanId, effectiveDate])
  @@map("ledger_transactions")
}

model Loan {
  id                 String              @id @default(cuid()) @db.VarChar(30)
  userId             String              @map("user_id") @db.VarChar(30)
  name               String              @db.VarChar(120)
  provider           String              @db.VarChar(120)
  principal          Decimal             @db.Decimal(18, 2)
  annualRate         Decimal             @map("annual_rate") @db.Decimal(7, 4)
  termMonths         Int                 @map("term_months") @db.UnsignedSmallInt
  emiAmount          Decimal             @map("emi_amount") @db.Decimal(18, 2)
  dueDay             Int                 @map("due_day") @db.UnsignedTinyInt
  startDate          DateTime            @map("start_date") @db.Date
  liabilityAccountId String              @unique @map("liability_account_id") @db.VarChar(30)
  status             LoanStatus          @default(ACTIVE)
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(128)
  requestHash        String              @map("request_hash") @db.Char(64)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  liabilityAccount   LedgerAccount       @relation("LoanLiability", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  transactions       LedgerTransaction[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, startDate])
  @@map("loans")
}

model TransactionEntry {
  id              String            @id @default(cuid()) @db.VarChar(30)
  transactionId   String            @map("transaction_id") @db.VarChar(30)
  ledgerAccountId String            @map("ledger_account_id") @db.VarChar(30)
  debitAmount     Decimal           @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount    Decimal           @default(0) @map("credit_amount") @db.Decimal(18, 2)
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([ledgerAccountId, transactionId])
  @@map("transaction_entries")
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  userId     String   @map("user_id") @db.VarChar(30)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(30)
  action     String   @db.VarChar(60)
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
