{
  "name": "finance-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait mysql && npm run db:generate && npm run db:deploy && tsc -p tsconfig.build.json && concurrently --kill-others -n api,build -c green,blue \"node --watch dist/server.js\" \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\"",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "npm run db:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/server": "^14.1.0",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "3.22.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
